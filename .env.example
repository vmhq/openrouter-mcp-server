# ============================================================
# OpenRouter MCP Server - variables de entorno
# Copia este archivo a .env y completa los valores.
# ============================================================

# --- Requerido ---
# Tu API key de OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-...

# --- Servidor HTTP ---
# Puerto donde se expone el endpoint MCP (http://host:PORT/mcp)
PORT=3000
# Token opcional para proteger el servidor remoto. Si se define, los clientes
# MCP deben enviar "Authorization: Bearer <token>". Muy recomendado si el
# servidor es accesible fuera de localhost.
MCP_AUTH_TOKEN=

# --- Atribución opcional en OpenRouter (rankings) ---
APP_URL=
APP_TITLE=OpenRouter MCP Server

# --- Política de delegación ---
# Modelo por defecto si el agente no especifica uno en openrouter_delegate_task
DEFAULT_MODEL=

# Límites de precio (USD por millón de tokens). Si un modelo los excede,
# la delegación se rechaza con un error explicativo. Vacío = sin límite.
MAX_PROMPT_PRICE_PER_M=
MAX_COMPLETION_PRICE_PER_M=

# Listas de control, separadas por comas. Aceptan ids exactos
# ("openai/gpt-4.1-mini") o prefijos de proveedor ("openai/").
# ALLOWED_MODELS vacío = todos permitidos (salvo los bloqueados).
ALLOWED_MODELS=
BLOCKED_MODELS=

# ¿Permitir modelos gratuitos (precio 0)? Suelen tener rate limits fuertes.
ALLOW_FREE_MODELS=true

# Proveedores preferidos para la selección automática (openrouter_auto_delegate)
PREFERRED_PROVIDERS=openai,anthropic,google,meta-llama,mistralai,deepseek,qwen,x-ai,amazon

# Techos de precio "combinado" (70% prompt + 30% completion, USD/M tokens)
# para cada tier de la selección automática.
TIER_ECONOMY_MAX_PRICE=0.5
TIER_BALANCED_MAX_PRICE=3
TIER_QUALITY_MAX_PRICE=15

# Cache del catálogo de modelos, en segundos
MODELS_CACHE_TTL_SECONDS=300
